{
  "name": "pixel-forge",
  "version": "0.1.0",
  "description": "A dependency-free pixel art editor that finds the sprites in a project, saves them back, and can open a pull request with the changes.",
  "type": "module",
  "bin": {
    "pixel-forge": "bin/pixel-forge.mjs"
  },
  "main": "index.mjs",
  "files": [
    "pixel-forge.js",
    "index.mjs",
    "index.d.ts",
    "index.html",
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "worker"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs test/worker.test.mjs",
    "e2e": "node test/e2e.mjs",
    "test:pack": "node test/pack.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./pixel-forge.js": "./pixel-forge.js",
    "./scan": "./src/scan.mjs",
    "./serve": "./src/serve.mjs",
    "./package.json": "./package.json"
  },
  "keywords": [
    "pixel-art",
    "sprite",
    "editor",
    "gamedev",
    "png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowu/pixel-forge.git"
  },
  "homepage": "https://github.com/snowu/pixel-forge#readme",
  "bugs": {
    "url": "https://github.com/snowu/pixel-forge/issues"
  }
}
